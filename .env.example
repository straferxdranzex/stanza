# ================================================================
# Stanza — Environment Variables
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control
# ================================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# ── Stripe ────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# For Connect Express: set to your platform's account
# (no additional env needed — platform account is implied by secret key)

# ── Zoom (Server-to-Server OAuth) ─────────────────────────────
# Create app at: https://marketplace.zoom.us/develop/create
# App type: Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your-account-id
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-client-secret

# ── Email (Resend) ────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM_DOMAIN=yourdomain.com

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron (for Edge Functions) ─────────────────────────────────
CRON_SECRET=your-random-cron-secret-min-32-chars

# ── Optional: Sentry for error tracking ──────────────────────
# SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_DSN=https://...
